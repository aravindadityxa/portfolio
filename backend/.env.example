# Environment Configuration
ENVIRONMENT=development
DEBUG=False

# Database
DATABASE_URL=sqlite:///./contact_messages.db

# Gmail SMTP Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_USE_TLS=True

# Portfolio owner email
OWNER_EMAIL=your-email@gmail.com

# CORS - Add your frontend URLs here
ALLOWED_ORIGINS=https://aravindadityxa.github.io,http://localhost:5500,http://127.0.0.1:5500

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=3600

# Security - Generate a strong random key
SECRET_KEY=generate-a-strong-random-key-here
